# dependencies & build scratch
node_modules/
.tmpbuild/
package-lock.json

# headless test captures (regenerated by tools/*.mjs)
s[0-9]*.png
c[0-9]*.png
t[0-9]*.png
d[0-9]*.png
p1-*.png
dev[0-9]*.png
opt*.png
ab-*.png
y[0-9]*.png
x[0-9]*.png

# local tuning sessions / editor noise
.DS_Store
*.log

# user-uploaded hero models: committed once, so they survive workspace resets
# (drop new/updated GLBs in here and commit them to swap hero skins)

# The Hero Studio's SAVE output. Deliberately NOT tracked: its absence is the shipped
# defaults, so a fresh clone always boots the way the procedural game was tuned to look,
# and every tweak in the panel would otherwise be a permanent repo diff. To make a tuned
# setup travel with the repo on purpose:  git add -f models/uploads/hero_tuning.json
models/uploads/hero_tuning.json

# Skill packages uploaded through the VFX dropbox are workspace data; keep
# versioned authoring samples under examples/skills/ instead.
models/uploads/*.skill.json
models/uploads/*.ability.json

# python bytecode
__pycache__/
